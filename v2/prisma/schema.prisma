generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String?
  createdAt           DateTime             @default(now())
  activeOrgId         String?
  memberships         OrgMember[]
  passwordResetTokens PasswordResetToken[]
}

model Organization {
  id                        String                @id @default(uuid())
  name                      String
  inn                       String?
  taxRegime                 TaxRegime             @default(TURNOVER_TAX)
  isVatPayer                Boolean               @default(false)
  /// Автоначисление налога на прибыль при финализации периода (E2 в closing.ts).
  /// false — проводка Дт9810/Кт6410 не создаётся (налог считают вручную),
  /// событие PROFIT_TAX в налоговом календаре создаётся в любом случае.
  autoAccrueProfitTax       Boolean               @default(true)
  /// Ставка налога на прибыль (ст. 337 НК: базовая 15%, банки/мобильная связь 20%,
  /// отдельные категории 0%). Настраивается per-org по образцу turnoverTaxRate.
  profitTaxRate             Float                 @default(0.15)
  /// Налоговая льгота организации. IT_PARK_RESIDENT — только поле в этом апдейте,
  /// полная логика применения льгот — отдельный эпик (ТЗ, раздел 7).
  taxBenefit                TaxBenefitType        @default(NONE)
  /// Дата регистрации резидентства IT Park; льготы применяются только с этой даты
  /// вперёд, не задним числом на уже закрытые периоды.
  itParkResidentSince       DateTime?
  itParkCertificateNumber   String?
  /// Среднегодовая численность работников / в т.ч. лица с инвалидностью —
  /// поля шапки «Расчёта налога на прибыль» my.soliq.uz (ручной ввод на портале).
  avgHeadcount              Int                   @default(1)
  avgHeadcountDisabled      Int                   @default(0)
  createdAt                 DateTime              @default(now())
  activityDescription       String?
  turnoverTaxRate           Float                 @default(0.04)
  aiConfidenceThreshold     Int                   @default(70)
  maxClarificationQuestions Int                   @default(10)
  settings                  Json?
  activityCustom            String?
  activityGroup             String?
  charterCapitalAmount      Decimal?                   @db.Decimal(18, 2)
  charterCapitalDeclaredAt  DateTime?
  charterCapitalFundingType CharterCapitalFundingType?
  auditLogs                 AuditLog[]
  bankAccounts              BankAccount[]
  classificationJobs        ClassificationJob[]
  closingJobs               ClosingJob[]
  counterparties            Counterparty[]
  documents                 Document[]
  openItems                 OpenItem[]
  members                   OrgMember[]
  payments                  Payment[]
  periods                   Period[]
  rules                     Rule[]
  subscription              Subscription?
  taxCalendar               TaxCalendarEvent[]
  taxTemplates              TaxDeadlineTemplate[]
  vouchers                  Voucher[]
  taxReportMappings         TaxReportAccountMapping[]
  costingMethodHistory      OrgCostingMethodHistory[]
}

model OrgMember {
  id     String       @id @default(uuid())
  role   OrgRole      @default(OWNER)
  userId String
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model BankAccount {
  id                 String              @id @default(uuid())
  orgId              String
  name               String
  currency           String              @default("UZS")
  bankName           String?
  accountNumber      String?
  lastBalance        Decimal             @default(0) @db.Decimal(20, 2)
  lastSyncedAt       DateTime?
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stagedTransactions StagedTransaction[]

  @@index([orgId])
}

model Period {
  id                 String              @id @default(uuid())
  orgId              String
  year               Int
  month              Int
  mode               PeriodMode          @default(ACTIVE)
  status             PeriodStatus        @default(OPEN)
  lockDate           DateTime?
  closingData        Json?
  documents          Document[]
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stagedTransactions StagedTransaction[]
  taxEvents          TaxCalendarEvent[]
  closingJobs        ClosingJob[]

  @@unique([orgId, year, month])
  @@index([orgId])
}

model StagedTransaction {
  id               String                  @id @default(uuid())
  orgId            String
  bankAccountId    String
  periodId         String
  date             DateTime
  amount           Decimal                 @db.Decimal(20, 2)
  direction        TransactionDirection
  description      String
  counterpartyHint String?
  counterpartyInn  String?
  hash             String
  status           StagedTransactionStatus @default(IMPORTED)
  aiSuggestion     Json?
  documentId       String?
  importBatchId    String?
  createdAt        DateTime                @default(now()) @db.Timestamptz(6)
  bankAccount      BankAccount             @relation(fields: [bankAccountId], references: [id])
  document         Document?               @relation(fields: [documentId], references: [id])
  period           Period                  @relation(fields: [periodId], references: [id])

  @@unique([orgId, hash])
  @@index([orgId, periodId])
  @@index([status])
  @@index([importBatchId])
}

model Rule {
  id           String        @id @default(uuid())
  orgId        String
  matchType    RuleMatchType
  matchValue   String
  categoryId   String
  direction    String?
  createdFrom  RuleSource    @default(USER_ANSWER)
  createdAt    DateTime      @default(now())
  order        Int           @default(0)
  documentType DocumentType  @relation(fields: [categoryId], references: [id])
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, matchType, matchValue])
  @@index([orgId])
}

model Account {
  id             String         @id @default(uuid())
  code           String         @unique
  name           String
  type           AccountType
  parentId       String?
  isSystem       Boolean        @default(true)
  group          String?
  isDeprecated   Boolean        @default(false)
  layer          AccountLayer   @default(CORE)
  parent         Account?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[]      @relation("AccountHierarchy")
  journalEntries JournalEntry[]
  openItems      OpenItem[]

  @@index([code])
  @@index([parentId])
}

model DocumentType {
  id              String     @id @default(uuid())
  code            String     @unique
  name            String
  postingTemplate Json
  mode            String     @default("BANK_AUTO")
  documents       Document[]
  rules           Rule[]
}

model Document {
  id                    String              @id @default(uuid())
  orgId                 String
  periodId              String
  typeId                String
  date                  DateTime
  status                DocumentStatus      @default(POSTED)
  payload               Json
  sourceTransactionId   String?             @unique
  correctionForPeriodId String?
  /// Переопределение вычитаемости расхода для «Расчёта налога на прибыль»
  /// (Приложение №2, графа 4): true — вычитаемый, false — невычитаемый,
  /// null — по дефолтному маппингу счёта/типа документа (TaxReportAccountMapping).
  /// Уровень Document, а не JournalEntry: проводки генерируются из postingTemplate,
  /// единица пользовательского ввода в системе — документ (ТЗ, раздел 1.2).
  taxDeductibleOverride Boolean?
  taxCalendarSyncStatus String?             /// PENDING | OK | FAILED — статус синхронизации налогового календаря
  taxCalendarSyncError  String?             /// Сообщение об ошибке синхронизации (если FAILED)
  org                   Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period                Period              @relation(fields: [periodId], references: [id])
  type                  DocumentType        @relation(fields: [typeId], references: [id])
  journalEntries        JournalEntry[]
  openItemsClosed       OpenItem[]          @relation("ClosingDocument")
  openItemsCreated      OpenItem[]          @relation("OpeningDocument")
  stagedTransactions    StagedTransaction[]

  @@index([orgId, periodId])
  @@index([orgId, date])
}

model JournalEntry {
  id             String        @id @default(uuid())
  documentId     String
  accountId      String
  debit          Decimal       @db.Decimal(20, 2)
  credit         Decimal       @db.Decimal(20, 2)
  date           DateTime
  counterpartyId String?
  contractId     String?
  account        Account       @relation(fields: [accountId], references: [id])
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id])
  document       Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([accountId, date])
  @@index([counterpartyId])
}

model Counterparty {
  id             String         @id @default(uuid())
  orgId          String
  name           String
  inn            String?
  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]
  openItems      OpenItem[]

  @@index([orgId])
}

model OpenItem {
  id                  String         @id @default(uuid())
  orgId               String
  accountId           String
  counterpartyId      String?
  openingDocumentId   String
  amount              Decimal        @db.Decimal(20, 2)
  dateOpened          DateTime
  status              OpenItemStatus @default(OPEN)
  riskDeadline        DateTime?
  closingDocumentId   String?
  dateClosed          DateTime?
  affectedPeriodId    String?
  awaitingInvoiceSign Boolean        @default(false)
  account             Account        @relation(fields: [accountId], references: [id])
  closingDocument     Document?      @relation("ClosingDocument", fields: [closingDocumentId], references: [id])
  counterparty        Counterparty?  @relation(fields: [counterpartyId], references: [id])
  openingDocument     Document       @relation("OpeningDocument", fields: [openingDocumentId], references: [id])
  org                 Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([orgId, affectedPeriodId])
}

model TaxCalendarEvent {
  id              String         @id @default(uuid())
  orgId           String
  periodId        String?
  type            TaxEventType
  dueDate         DateTime
  status          TaxEventStatus @default(PENDING)
  estimatedAmount Decimal?       @db.Decimal(20, 2)
  note            String?
  org             Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period          Period?        @relation(fields: [periodId], references: [id])

  @@index([orgId, dueDate])
}

model TaxDeadlineTemplate {
  id         String       @id @default(uuid())
  orgId      String
  type       TaxEventType
  dayOfMonth Int
  frequency  Frequency
  taxRegime  TaxRegime?
  isActive   Boolean      @default(true)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model AuditLog {
  id         String       @id @default(uuid())
  orgId      String
  userId     String
  action     String
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model Subscription {
  id           String       @id @default(uuid())
  orgId        String       @unique
  plan         PlanType     @default(FREE)
  validUntil   DateTime?
  customApiKey String?
  updatedAt    DateTime     @updatedAt
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String       @id @default(uuid())
  orderCode   String?      @unique
  orgId       String
  provider    String
  externalId  String       @unique
  amount      Decimal      @db.Decimal(20, 2)
  currency    String       @default("UZS")
  status      String       @default("PENDING")
  daysGranted Int          @default(365)
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  cancelTime  DateTime?
  cancelReason String?
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([externalId])
  @@index([orderCode])
}

model Voucher {
  id          String        @id @default(uuid())
  code        String        @unique
  series      String        @default("CV2")
  daysGranted Int
  usedByOrgId String?
  usedAt      DateTime?
  createdAt   DateTime      @default(now())
  org         Organization? @relation(fields: [usedByOrgId], references: [id], onDelete: SetNull)

  @@index([series])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

enum TaxRegime {
  VAT
  TURNOVER_TAX
}

enum OrgRole {
  OWNER
  ACCOUNTANT
  ADMIN
}

enum CharterCapitalFundingType {
  FULLY_PAID_CASH
  PARTIALLY_PAID
  PAID_IN_KIND
  NOT_PAID
}

enum PeriodMode {
  HISTORICAL
  ACTIVE
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum StagedTransactionStatus {
  IMPORTED
  AUTO_MATCHED
  NEEDS_CLARIFICATION
  CONFIRMED
  POSTED
  SKIPPED
}

enum RuleMatchType {
  INN
  KEYWORD
  AMOUNT_RANGE
  TREASURY_ACCOUNT
}

enum RuleSource {
  USER_ANSWER
  MANUAL
  AI_SUGGESTED
}

enum AccountType {
  ASSET
  CONTRA_ASSET
  LIABILITY
  CONTRA_LIABILITY
  ACTIVE_PASSIVE
  TRANSIT
  OFF_BALANCE
}

enum AccountLayer {
  CORE
  EXTENSION
  INDUSTRY
}

enum DocumentStatus {
  POSTED
  VOIDED
}

enum OpenItemStatus {
  OPEN
  CLOSED
  RISK
}

enum TaxEventType {
  VAT
  PERSONAL_INCOME_TAX
  TURNOVER_TAX
  PROFIT_TAX
  STATISTICS
  SOCIAL_TAX
  INPS
}

enum TaxEventStatus {
  PENDING
  DONE
}

enum PlanType {
  FREE
  PRO
}

enum Frequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model ClassificationJob {
  id                 String       @id // Usually maps to periodId
  orgId              String
  status             String       @default("running") // "running" | "done" | "failed"
  total              Int          @default(0) // total transactions to classify
  processed          Int          @default(0) // transactions processed so far
  matched            Int          @default(0)
  needsClarification Int          @default(0)
  error              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Маппинг «счёт НСБУ (и опционально тип документа) → строка приложения
/// Расчёта налога на прибыль» (ТЗ, раздел 1.1). Строки с orgId = null —
/// дефолтный маппинг для всех организаций (сидится в ensureBaseData из
/// DEFAULT_TAX_REPORT_MAPPING); строка с orgId организации переопределяет
/// дефолт для того же (accountCode, documentTypeCode, appendixCode).
/// documentTypeCode — расширение схемы ТЗ: в этом проекте один счёт (напр. 9420)
/// наполняется разными типами документов (SALARY_ACCRUAL → строка 0105,
/// RENT_ACCRUAL → 0111, прочее → 0137), поэтому маппинг по типу документа
/// имеет приоритет над маппингом по счёту.
model TaxReportAccountMapping {
  id               String          @id @default(uuid())
  orgId            String?
  accountCode      String
  /// null — правило применяется к любому типу документа (маппинг по счёту);
  /// не-null — правило только для проводок документов этого типа (приоритетнее).
  documentTypeCode String?
  appendixCode     TaxAppendixCode
  lineCode         String
  column           TaxReportColumn @default(TOTAL)
  isDefault        Boolean         @default(true)
  org              Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([accountCode])
}

/// История метода себестоимости по налоговым годам (ТЗ, раздел 0.3).
/// Отдельная таблица, а не мутируемое поле настроек: генератор отчёта за
/// прошлый период всегда берёт метод, действовавший в ТОМ году. Если записи
/// на год N нет — действует метод последнего года ≤ N (метод «тянется»,
/// новая запись нужна только при первом выборе и при смене).
model OrgCostingMethodHistory {
  id            String        @id @default(uuid())
  orgId         String
  fiscalYear    Int
  costingMethod CostingMethod
  setAt         DateTime      @default(now())
  setById       String?
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, fiscalYear])
  @@index([orgId])
}

enum TaxBenefitType {
  NONE
  IT_PARK_RESIDENT
}

enum CostingMethod {
  PROPORTIONAL
  DIRECT
}

enum TaxAppendixCode {
  APPENDIX_1
  APPENDIX_2
}

enum TaxReportColumn {
  TOTAL
  NON_DEDUCTIBLE
}

model ClosingJob {
  id        String   @id @default(uuid())
  periodId  String
  orgId     String
  status    String   @default("DRAFT") // DRAFT | RUNNING | FAILED | COMPLETED | CANCELLED
  step      Int      @default(1)
  data      Json     @default("{}")
  error     String?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  period    Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([periodId, orgId])
  @@index([orgId])
  @@index([status])
}
