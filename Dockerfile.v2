FROM node:20-alpine AS deps
WORKDIR /app
COPY v2/package*.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY v2/ .
# Генерируем Prisma Client перед сборкой
RUN npx prisma generate
# Жёсткий потолок памяти для сборки (V8 heap): без него next build не ограничен
# ничем и однажды съел всю RAM хоста (15.5GB, без swap), уронив VM целиком —
# 19.08.2026. 3GB heap + next.config.ts cpus:1 (один воркер вместо одного на
# ядро) держат пик сборки предсказуемым и оставляют хосту память для остальных
# ~30 контейнеров других проектов. Если сборка упадёт с "JavaScript heap out of
# memory" — значит порог реально нужен выше; поднимайте это число, а не убирайте.
ENV NODE_OPTIONS="--max-old-space-size=3072"
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Копируем только нужное для запуска
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

EXPOSE 3032
ENV PORT=3032
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
